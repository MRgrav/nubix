// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id         Int      @id @default(autoincrement())
  name       String
  schoolCode String   @unique @db.Char(4)
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // users associated with this school (admins or system users)
  users      User[]
  students   Student[]
  staff      Staff[]
  classrooms Classroom[]
  subjects    Subject[]
  examinations Examination[]
  assignments Assignment[]
}

model Student {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  grade       String?
  dateOfBirth DateTime?
  enrolledAt  DateTime  @default(now())

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  // a student belongs to a single classroom
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId Int?

  // subjects the student is enrolled in (many-to-many)
  subjects     Subject[]
  
  // attendance records for the student
  attendances  Attendance[]

  // examination results for the student
  examinationResults ExaminationResult[]
}

model Staff {
  id         Int      @id @default(autoincrement())
  hiredAt    DateTime @default(now())

  // --- Basic details tab ---
  employeeId        String? @unique
  title             String?
  name              String
  gender            String?
  employeeType      String?
  role              String
  designation       String?
  dateOfBirth       DateTime?
  dateOfJoining     DateTime?
  fatherHusbandName String?
  qualification     String?

  // --- Address / location block ---
  address  String?
  city     String?
  state    String?
  pincode  String?
  location String?

  // --- Identity details ---
  aadharNumber String?
  panNumber    String?

  // --- Contact block ---
  mobile          String?
  alternateMobile String?
  email           String  @unique
  alternateEmail  String?
  brokerBranch    String?

  // --- Bank details tab ---
  bankName          String?
  bankBranchName    String?
  bankAccountNumber String?
  ifscCode          String?

  // --- Document uploads tab ---
  jobOfferLetterUrl        String?
  joiningLetterUrl         String?
  ndaUrl                   String?
  experienceLetterUrl      String?
  relievingLetterUrl       String?
  salarySlipUrl            String?
  aadhaarCardUrl           String?
  panCardUrl               String?
  cancelledChequeUrl       String?
  passportUrl              String?
  sscCertificateUrl        String?
  hscCertificateUrl        String?
  graduationCertificateUrl String?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  // attendance records for staff
  attendances Attendance[]

  // subjects taught by staff
  subjects    Subject[]

  // assignments created by staff
  assignments Assignment[]
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String // hashed password (never store plain text)
  role                Role      @default(STUDENT)
  createdAt           DateTime  @default(now())
  resetToken          String? // for password reset
  resetTokenExpiresAt DateTime?

  student Student?
  staff   Staff?
  
  // optional relation to a School (useful for ADMIN or general user association)
  school   School? @relation(fields: [schoolId], references: [id])
  schoolId Int?
}

model Attendance {
  id         Int              @id @default(autoincrement())
  date       DateTime
  status     AttendanceStatus
  note       String?
  createdAt  DateTime         @default(now())

  // Either studentId or staffId will be set
  student    Student?         @relation(fields: [studentId], references: [id])
  studentId  Int?

  staff      Staff?           @relation(fields: [staffId], references: [id])
  staffId    Int?

  @@index([studentId])
  @@index([staffId])
  @@index([date])
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // teacher responsible for this subject
  teacherId   Int?
  teacher     Staff?   @relation(fields: [teacherId], references: [id])
  teacherName String?

  // students enrolled in this subject
  students Student[]
  
  // optional relation to School
  school     School?  @relation(fields: [schoolId], references: [id])
  schoolId   Int?

  @@index([teacherId])
}

model Classroom {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  // many-to-many with Student
  students Student[]

  // examinations for this classroom
  examinations Examination[]

  // assignments for this classroom
  assignments Assignment[]
}

enum ExaminationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Examination {
  id          Int                @id @default(autoincrement())
  title       String
  description String?
  subject     String
  examDate    DateTime
  duration    Int                // duration in minutes
  totalMarks  Float
  status      ExaminationStatus  @default(SCHEDULED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  school      School             @relation(fields: [schoolId], references: [id])
  schoolId    Int

  classroom   Classroom          @relation(fields: [classroomId], references: [id])
  classroomId Int

  results     ExaminationResult[]

  @@index([schoolId])
  @@index([classroomId])
  @@index([examDate])
}

model ExaminationResult {
  id            Int          @id @default(autoincrement())
  marksObtained Float
  remarks       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  examination   Examination  @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId Int

  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     Int

  @@unique([examinationId, studentId])
  @@index([studentId])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  className   String   // e.g. "LKG", "UKG", "Class 1"
  fromDate    DateTime
  toDate      DateTime
  fileUrl     String   // link to image or PDF
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School    @relation(fields: [schoolId], references: [id])
  schoolId    Int

  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int

  createdBy   Staff?    @relation(fields: [createdById], references: [id])
  createdById Int?

  @@index([schoolId])
  @@index([classroomId])
  @@index([createdById])
  @@index([fromDate])
  @@index([toDate])
}

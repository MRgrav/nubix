// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  label     String   @unique // "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableSlots     TimetableSlot[]
  examTerms          ExamTerm[]
  assignments        Assignment[]
  studentStreams     StudentStream[]
  attendance         Attendance[]
  announcement       Announcement[]
  ptmRequest         PTMRequest[]
  teacherAssignments TeacherAssignment[]

  curriculumSubjects CurriculumSubject[]

  feeStructures          FeeStructure[]
  studentFees            StudentFee[]
  lateFeeConfigs         LateFeeConfig[]
  studentTransports      StudentTransport[]
  studentElectiveChoices StudentElectiveChoice[]
  BoardVersion           BoardVersion[]
  ExamConfig             ExamConfig[]
  gradingSchemes         GradingScheme[]

  @@index([isActive])
  @@index([startDate, endDate])
}

model Stream {
  id          Int     @id @default(autoincrement())
  name        String  @unique // "Science", "Commerce"
  description String?

  studentStreams StudentStream[]
  announcements  Announcement[]  @relation("StreamAnnouncements")
  assignments    Assignment[]    @relation("StreamAssignments")

  teacherAssignments TeacherAssignment[]

  curriculumSubjects CurriculumSubject[]

  feeStructures    FeeStructure[]
  timetableSlot    TimetableSlot[]
  Exam             Exam[]
  AdmissionRequest AdmissionRequest[]

  @@index([name])
}

model StudentStream {
  id Int @id @default(autoincrement())

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id])

  rollNo String?

  createdAt DateTime @default(now())

  @@unique([academicYearId, studentId])
  @@unique([academicYearId, classroomId, rollNo])
  @@index([studentId, academicYearId])
  @@index([classroomId])
}

model School {
  id           Int      @id @default(autoincrement())
  name         String
  schoolCode   String   @unique @db.Char(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rollNoFormat String?

  users              User[]
  students           Student[]
  staff              Staff[]
  classrooms         Classroom[]
  subjects           Subject[]
  assignments        Assignment[]
  timetableSlots     TimetableSlot[]
  announcements      Announcement[]      @relation("SchoolAnnouncements")
  curriculumSubjects CurriculumSubject[]
  admissionRequests  AdmissionRequest[]
  boards             Board[]
  address            Address?            @relation("SchoolAddress")
  documents          SchoolDocument[]
}

model SchoolDocument {
  id                 Int      @id @default(autoincrement())
  schoolId           Int
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  documentType       String
  title              String?
  fileUrl            String
  pocketbaseRecordId String?
  mimeType           String?
  fileSizeBytes      Int?
  uploadedById       Int?
  uploadedBy         User?    @relation("UploadedSchoolDocuments", fields: [uploadedById], references: [id])
  uploadedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([schoolId, documentType])
  @@index([schoolId])
  @@index([documentType])
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model TeacherAssignment {
  id        Int   @id @default(autoincrement())
  teacherId Int
  teacher   Staff @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  classroomId Int?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  fromDate DateTime? // For temporary assignments
  toDate   DateTime? // Null = permanent

  status AssignmentStatus @default(ACTIVE)

  assignedById Int
  assignedBy   User @relation(fields: [assignedById], references: [id])

  assignedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Retain only the full unique index to allow date-based variations
  @@unique([teacherId, subjectId, classroomId, academicYearId, streamId, fromDate, toDate], map: "teacher_assignment_full_idx")
  @@index([teacherId])
  @@index([subjectId])
  @@index([classroomId])
  @@index([academicYearId])
  @@index([streamId])
}

model Student {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  grade       String?
  dateOfBirth DateTime?
  enrolledAt  DateTime  @default(now())

  gender               String?
  previousSchoolName   String?
  previousClass        String?
  previousGrade        String?
  promotedToClass      String?
  totalAdmissionAmount Float?
  monthlyFees          Float?
  admissionDate        DateTime?
  admissionReceiptNo   String?
  admissionReceiptLink String?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  // a student belongs to a single classroom
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId Int?

  // subjects the student is enrolled in (many-to-many)
  subjects Subject[]

  // attendance records for the student
  attendances Attendance[]

  // examination results for the student
  examMarks   ExamMarks[]
  examResults ExamResult[]
  ptmRequests PTMRequest[]

  studentStreams StudentStream[]

  studentFees       StudentFee[]
  studentTransports StudentTransport[]

  parents StudentParent[]

  studentElectiveChoices StudentElectiveChoice[]

  currentAddressId Int?
  currentAddress   Address? @relation("StudentCurrentAddress", fields: [currentAddressId], references: [id])

  permanentAddressId Int?
  permanentAddress   Address?           @relation("StudentPermanentAddress", fields: [permanentAddressId], references: [id])
  admissions         AdmissionRequest[]
}

model Staff {
  id      Int      @id @default(autoincrement())
  hiredAt DateTime @default(now())

  // --- Basic details tab ---
  employeeId    String?   @unique
  title         String?
  name          String
  gender        String?
  employeeType  String?
  role          String?
  designation   String?
  dateOfBirth   DateTime?
  dateOfJoining DateTime?

  // --- Identity details ---
  aadharNumber String?
  panNumber    String?

  // --- Contact block ---
  mobile          String?
  alternateMobile String?
  email           String  @unique
  alternateEmail  String?
  brokerBranch    String?

  // --- Bank details tab ---
  bankName          String?
  bankBranchName    String?
  bankAccountNumber String?
  ifscCode          String?

  isActive       Boolean         @default(true)
  employeeStatus EmployeeStatus? @default(ACTIVE)

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  // attendance records for staff
  attendances Attendance[]

  // subjects taught by staff
  subjects Subject[]

  // assignments created by staff
  assignments    Assignment[]
  timetableSlots TimetableSlot[]

  teacherAssignments TeacherAssignment[]
  addresses          Address[]               @relation("StaffAddresses")
  documents          StaffDocument[]
  emergencyContacts  StaffEmergencyContact[]
  qualifications     StaffQualification[]

  createdById Int?
  updatedById Int?
  createdBy   User? @relation("CreatedStaff", fields: [createdById], references: [id])
  updatedBy   User? @relation("UpdatedStaff", fields: [updatedById], references: [id])
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  SUSPENDED
}

model StaffDocument {
  id                 Int      @id @default(autoincrement())
  staffId            Int
  staff              Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  documentType       String
  title              String?
  fileUrl            String
  pocketbaseRecordId String?
  mimeType           String?
  fileSizeBytes      Int?
  uploadedById       Int?
  uploadedBy         User?    @relation("UploadedStaffDocuments", fields: [uploadedById], references: [id])
  uploadedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([staffId, documentType])
  @@index([staffId])
  @@index([documentType])
}

model StaffEmergencyContact {
  id        Int     @id @default(autoincrement())
  staffId   Int
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  phone     String
  email     String?
  isPrimary Boolean @default(false)

  @@unique([staffId, isPrimary])
  @@index([staffId])
}

model StaffQualification {
  id             Int     @id @default(autoincrement())
  staffId        Int
  staff          Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  degree         String
  institution    String?
  yearOfPassing  Int?
  grade          String?
  certificateUrl String?

  @@index([staffId])
}

enum Role {
  STUDENT
  STAFF
  ADMIN
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String // hashed password (never store plain text)
  role                Role      @default(STUDENT)
  createdAt           DateTime  @default(now())
  resetToken          String? // for password reset
  resetTokenExpiresAt DateTime?

  student Student?
  staff   Staff?

  school                School?        @relation(fields: [schoolId], references: [id])
  schoolId              Int?
  announcements         Announcement[] @relation("UserAnnouncements")
  ptmRequestsCreated    PTMRequest[]   @relation("PTMRequestedBy")
  ptmRequestsReceived   PTMRequest[]   @relation("PTMRequestedTo")
  ptmRequestsHandled    PTMRequest[]   @relation("PTMRespondedBy")
  leaveRequests         LeaveRequest[] @relation("LeaveRequestedBy")
  leaveRequestsApproved LeaveRequest[] @relation("LeaveApprovedBy")

  discountsCreated   Discount[]      @relation
  adjustmentsCreated FeeAdjustment[] @relation

  teacherAssignmentsAssigned TeacherAssignment[]     @relation
  approvedElectiveChoices    StudentElectiveChoice[] @relation("ElectiveApprovedBy")
  parent                     Parent?
  createdAdmissions          AdmissionRequest[]      @relation("CreatedAdmissions")
  approvedAdmissions         AdmissionRequest[]      @relation("ApprovedAdmissions")

  createdTerms ExamTerm[] @relation("TermCreatedBy")
  updatedTerms ExamTerm[] @relation("TermUpdatedBy")

  createdExams Exam[] @relation("ExamCreatedBy")
  updatedExams Exam[] @relation("ExamUpdatedBy")

  createdConfigs ExamConfig[] @relation("ConfigCreatedBy")
  updatedConfigs ExamConfig[] @relation("ConfigUpdatedBy")

  createdSchemes GradingScheme[] @relation("SchemeCreatedBy")
  updatedSchemes GradingScheme[] @relation("SchemeUpdatedBy")

  enteredMarks ExamMarks[] @relation("MarksEnteredBy")
  updatedMarks ExamMarks[] @relation("MarksUpdatedBy")

  calculatedResults ExamResult[] @relation("ResultCalculatedBy")
  updatedResults    ExamResult[] @relation("ResultUpdatedBy")

  createdStaff Staff[] @relation("CreatedStaff")
  updatedStaff Staff[] @relation("UpdatedStaff")

  uploadedStaffDocuments StaffDocument[]     @relation("UploadedStaffDocuments")
  uploadedDocuments      AdmissionDocument[] @relation("UploadedDocuments")
  uploadedSchoolDocs     SchoolDocument[]    @relation("UploadedSchoolDocuments")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())

  student   Student? @relation(fields: [studentId], references: [id])
  studentId Int?

  staff   Staff? @relation(fields: [staffId], references: [id])
  staffId Int?

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId Int?

  @@unique([studentId, date, academicYearId, subjectId])
  @@unique([staffId, date, academicYearId])
  @@index([studentId])
  @@index([staffId])
  @@index([date])
  @@index([academicYearId])
  @@index([subjectId])
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // teacher responsible for this subject

  teachers Staff[]

  // students enrolled in this subject
  students Student[]

  // optional relation to School
  school   School? @relation(fields: [schoolId], references: [id])
  schoolId Int?

  timetableSlots TimetableSlot[]

  teacherAssignments TeacherAssignment[]

  curriculumSubjects CurriculumSubject[]

  attendances Attendance[]
  ExamConfig  ExamConfig[]
  Exam        Exam[]
}

model Classroom {
  id                      Int      @id @default(autoincrement())
  name                    String
  section                 String   @default("A")
  isSubjectWiseAttendance Boolean  @default(false) // Dynamic: determines if this class needs subject-wise attendance
  createdAt               DateTime @default(now())

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  // many-to-many with Student
  students Student[]

  // examinations for this classroom
  exams Exam[]

  // assignments for this classroom
  assignments    Assignment[]
  timetableSlots TimetableSlot[]
  StudentStream  StudentStream[]

  teacherAssignments TeacherAssignment[]
  announcements      Announcement[]      @relation("ClassroomAnnouncements")
  AdmissionRequest   AdmissionRequest[]
  curriculumSubjects CurriculumSubject[]
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotType {
  CLASS
  BREAK
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  className   String // e.g. "LKG", "UKG", "Class 1"
  fromDate    DateTime
  toDate      DateTime
  fileUrl     String // link to image or PDF
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  targetClass   String? // e.g. "11"
  targetSection String? // e.g. "A"
  streamId      Int? // e.g. Science
  stream        Stream? @relation("StreamAssignments", fields: [streamId], references: [id])

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int

  createdBy   Staff? @relation(fields: [createdById], references: [id])
  createdById Int?

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([classroomId, academicYearId])
  @@index([schoolId])
  @@index([classroomId])
  @@index([createdById])
  @@index([fromDate])
  @@index([toDate])
}

model TimetableSlot {
  id           Int       @id @default(autoincrement())
  day          DayOfWeek
  slotType     SlotType
  startMinutes Int
  endMinutes   Int
  notes        String?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int

  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId Int?

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  teacher   Staff? @relation(fields: [teacherId], references: [id])
  teacherId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([schoolId])
  @@index([classroomId])
  @@index([day])
  @@index([academicYearId])
  @@index([streamId])
}

enum AnnouncementType {
  notice
  event
}

enum CreatedRole {
  STAFF
  ADMIN
  PRINCIPAL
}

model Announcement {
  id   Int              @id @default(autoincrement())
  type AnnouncementType

  title       String
  description String

  link  String?
  media String?

  classroomId Int?
  classroom   Classroom? @relation("ClassroomAnnouncements", fields: [classroomId], references: [id])

  isSuspended Boolean @default(false)

  createdById   Int
  createdByRole CreatedRole

  createdBy User @relation("UserAnnouncements", fields: [createdById], references: [id])

  schoolId Int
  school   School @relation("SchoolAnnouncements", fields: [schoolId], references: [id])

  streamId Int?
  stream   Stream? @relation("StreamAnnouncements", fields: [streamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([schoolId, isSuspended])
  @@index([classroomId])
}

// PTM Schemas
enum PTMStatus {
  pending
  approved
  postponed
  rejected
}

enum PTMMode {
  online
  offline
}

enum PTMRole {
  STUDENT
  STAFF
  ADMIN
  PARENT
}

model PTMRequest {
  id Int @id @default(autoincrement())

  // Student involved
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  class   String
  section String

  // Request creator
  requestedById   Int
  requestedBy     User    @relation("PTMRequestedBy", fields: [requestedById], references: [id])
  requestedByRole PTMRole

  // Receiver
  requestedToId   Int
  requestedTo     User    @relation("PTMRequestedTo", fields: [requestedToId], references: [id])
  requestedToRole PTMRole

  requestedDate DateTime
  requestedTime String
  mode          PTMMode  @default(offline)

  status PTMStatus @default(pending)

  responseById   Int?
  responseBy     User?     @relation("PTMRespondedBy", fields: [responseById], references: [id])
  responseByRole PTMRole?
  responseDate   DateTime?

  suggestedDate DateTime?
  suggestedTime String?

  purpose String?

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId])
  @@index([studentId])
  @@index([requestedById])
  @@index([requestedToId])
  @@index([status])
}

enum LeaveType {
  casual
  sick
  earned
  other
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum LeaveUserRole {
  staff
  admin
}

model LeaveRequest {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("LeaveRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  userRole       LeaveUserRole
  leaveType      LeaveType
  reason         String        @db.Text
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  numberOfDays   Int
  status         LeaveStatus   @default(pending)
  approvedBy     Int?
  approvedByUser User?         @relation("LeaveApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([approvedBy])
}

enum CurriculumCategory {
  CORE
  ELECTIVE
  ACTIVITY
}

model CurriculumSubject {
  id             Int          @id @default(autoincrement())
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  classroomId Int? // ← NEW: replace className
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  category    CurriculumCategory
  isMandatory Boolean            @default(true)

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentElectiveChoices StudentElectiveChoice[]

  @@unique([academicYearId, classroomId, streamId, subjectId])
  @@index([academicYearId])
  @@index([classroomId])
  @@index([streamId])
  @@index([subjectId])
}

enum FeeCategoryType {
  TUITION
  TRANSPORT
  EXAM
  ADMISSION
  REGISTRATION
  CAUTION_MONEY
  ID_CARD
  ANNUAL_CHARGES
  LIBRARY
  COMPUTER
  LABORATORY
  SPORTS
  ARTS
  HOSTEL
  MESS
  BOOKS
  UNIFORM
  INSURANCE
  LAB
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum AdjustmentType {
  REFUND
  FINE
  DISCOUNT
  OTHER
}

model FeeCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  type        FeeCategoryType
  description String?
  isDefault   Boolean         @default(false) // Built-in like Tuition
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  feeStructures FeeStructure[]
}

model FeeStructure {
  id             Int      @id @default(autoincrement())
  academicYearId Int
  className      String // e.g., "Class 11"
  streamId       Int?
  categoryId     Int
  amount         Float
  isLocked       Boolean  @default(false) // For previous years
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  stream       Stream?      @relation(fields: [streamId], references: [id], onDelete: SetNull)
  category     FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  studentFeeItems StudentFeeItem[]

  @@unique([academicYearId, className, streamId, categoryId])
  @@index([academicYearId])
  @@index([className])
  @@index([streamId])
  @@index([categoryId])
}

model StudentFee {
  id             Int @id @default(autoincrement())
  studentId      Int
  academicYearId Int

  totalAmount     Float
  paidAmount      Float     @default(0)
  dueAmount       Float
  lastPaymentDate DateTime?
  isFrozen        Boolean   @default(false) // Freeze after admission
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  payments    Payment[]
  discounts   Discount[]
  adjustments FeeAdjustment[]
  lateFees    LateFee[]
  items       StudentFeeItem[]

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
}

model StudentFeeItem {
  id             Int      @id @default(autoincrement())
  studentFeeId   Int
  feeStructureId Int
  assignedAmount Float // Copy of amount at time of assignment (for history)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studentFee   StudentFee   @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@unique([studentFeeId, feeStructureId])
  @@index([studentFeeId])
  @@index([feeStructureId])
}

model Payment {
  id           Int           @id @default(autoincrement())
  studentFeeId Int
  amount       Float
  paymentDate  DateTime      @default(now())
  method       PaymentMethod
  receiptNo    String?       @unique
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
  @@index([paymentDate])
}

model Discount {
  id           Int          @id @default(autoincrement())
  studentFeeId Int
  type         DiscountType
  amount       Float? // For FIXED
  percentage   Float? // For PERCENTAGE
  reason       String
  appliedDate  DateTime     @default(now())
  createdById  Int // Admin/Staff who applied
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@index([studentFeeId])
}

model LateFeeConfig {
  id             Int      @id @default(autoincrement())
  academicYearId Int
  fineAmount     Float
  isPercentage   Boolean  @default(false) // % of due or fixed
  perPeriod      String // e.g., "MONTHLY"
  graceDays      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId])
}

model LateFee {
  id           Int      @id @default(autoincrement())
  studentFeeId Int
  amount       Float
  appliedDate  DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
}

model TransportRoute {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  feeAmount   Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentTransports StudentTransport[]
}

model StudentTransport {
  id             Int       @id @default(autoincrement())
  studentId      Int
  academicYearId Int
  routeId        Int
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([routeId])
}

model FeeAdjustment {
  id             Int            @id @default(autoincrement())
  studentFeeId   Int
  type           AdjustmentType
  amount         Float // Negative for refund
  reason         String
  adjustmentDate DateTime       @default(now())
  createdById    Int
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@index([studentFeeId])
}

enum ParentType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Parent {
  id        Int        @id @default(autoincrement())
  type      ParentType
  name      String // Required in controller
  email     String     @unique
  phone     String?
  address   String?
  isActive  Boolean    @default(true) // For soft delete
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  students StudentParent[] // Many-to-many
}

model StudentParent {
  studentId Int
  parentId  Int
  isPrimary Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
}

enum ElectiveStatus {
  PENDING
  APPROVED
  REJECTED
  DROPPED
}

model StudentElectiveChoice {
  id Int @id @default(autoincrement())

  studentId           Int
  academicYearId      Int
  curriculumSubjectId Int

  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)

  approvedById Int?
  approvedBy   User?     @relation("ElectiveApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @default(now())

  status ElectiveStatus @default(PENDING)

  @@unique([studentId, academicYearId, curriculumSubjectId])
  @@index([studentId, academicYearId])
  @@index([curriculumSubjectId])
}

model AdmissionRequest {
  id            Int     @id @default(autoincrement())
  applicationNo String? @unique

  name                     String
  email                    String
  gender                   Gender?
  dateOfBirth              DateTime?
  aadhaarNumber            String?
  permanentEducationNumber String?

  currentAddressId Int?
  currentAddress   Address? @relation("AdmissionCurrentAddress", fields: [currentAddressId], references: [id])

  permanentAddressId Int?
  permanentAddress   Address? @relation("AdmissionPermanentAddress", fields: [permanentAddressId], references: [id])

  category           AdmissionCategory?
  isStaffWard        Boolean            @default(false)
  hasSiblingInSchool Boolean            @default(false)

  previousSchoolName            String?
  previousSchoolAddress         String?
  previousClass                 String?
  previousGrade                 String?
  totalSubjectsInPrevClass      Int?
  totalMarksObtainedInPrevClass Int?
  fullMarksInPrevClass          Int?

  admissionForClass  String?
  requestedForStream String?

  requestedClassroomId Int?
  requestedClassroom   Classroom? @relation(fields: [requestedClassroomId], references: [id])

  requestedStreamId Int?
  requestedStream   Stream? @relation(fields: [requestedStreamId], references: [id])

  parents          Json?
  electiveSubjects Json?

  totalAdmissionAmount Float?
  monthlyFees          Float?
  admissionReceiptNo   String?
  admissionReceiptLink String?

  documents AdmissionDocument[]

  status          AdmissionStatus @default(PENDING)
  appliedAt       DateTime        @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  notes           String?

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  createdById Int?
  createdBy   User? @relation("CreatedAdmissions", fields: [createdById], references: [id])

  approvedById Int?
  approvedBy   User? @relation("ApprovedAdmissions", fields: [approvedById], references: [id])

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id])

  isReAdmission Boolean @default(false)

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  @@index([schoolId, status])
  @@index([email])
  @@index([isArchived])
}

model AdmissionDocument {
  id Int @id @default(autoincrement())

  // Document metadata
  documentType       AdmissionDocumentType // e.g., MARKSHEET, PHOTO, RECEIPT, FORM, AADHAAR, etc.
  title              String? // e.g., "Class 10 Marksheet", "Admission Receipt"
  fileUrl            String // S3 / Cloudinary / local URL
  fileName           String
  mimeType           String? // e.g., image/jpeg, application/pdf
  fileSizeBytes      Int?
  uploadedAt         DateTime              @default(now())
  pocketbaseRecordId String?

  // Who uploaded (optional audit)
  uploadedById Int?
  uploadedBy   User? @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  // Link to admission request
  admissionRequestId Int
  admissionRequest   AdmissionRequest @relation(fields: [admissionRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionRequestId])
  @@index([documentType])
  @@index([uploadedAt])
}

enum AdmissionDocumentType {
  ADMISSION_FORM
  PHOTO
  MARKSHEET_PREV_CLASS
  TRANSFER_CERTIFICATE
  AADHAAR_CARD
  BIRTH_CERTIFICATE
  RECEIPT_ADMISSION_FEE
  OTHER_CERTIFICATE
  OTHER_DOCUMENT
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  APPROVED
  REJECTED
  WAITLISTED
}

enum AdmissionCategory {
  GENERAL
  SC
  ST
  OBC
  EWS
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Address {
  id Int @id @default(autoincrement())

  houseNo      String? // House/Flat/Plot number
  addressLine1 String // Main street/address (required)
  addressLine2 String? // Additional details (colony, area, etc.)
  landmark     String? // Nearby landmark
  city         String
  district     String?
  state        String
  pinCode      String
  postOffice   String? // Post office name (sometimes required)
  country      String  @default("India")

  // Address purpose/type (helps distinguish current vs permanent)
  addressType AddressType @default(CURRENT)

  // Optional geolocation (future-proof, can be added via frontend map later)
  latitude  Float?
  longitude Float?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Relations ───
  // Current address used by admission requests
  currentAdmissionRequests AdmissionRequest[] @relation("AdmissionCurrentAddress")

  // Permanent address used by admission requests
  permanentAdmissionRequests AdmissionRequest[] @relation("AdmissionPermanentAddress")

  // Current address used by students
  currentStudents Student[] @relation("StudentCurrentAddress")

  // Permanent address used by students
  permanentStudents Student[] @relation("StudentPermanentAddress")

  // Future extensions (commented out — add when needed)
  staffId  Int?
  staff    Staff?  @relation("StaffAddresses", fields: [staffId], references: [id], onDelete: SetNull)
  // schoolBranches             School[]             @relation("SchoolBranchAddress")
  schoolId Int?    @unique
  school   School? @relation("SchoolAddress", fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([staffId, addressType])
  @@index([pinCode])
  @@index([city, state])
  @@index([addressType])
}

enum AddressType {
  CURRENT
  PERMANENT
  CORRESPONDENCE
  OFFICE
  OTHER
}

model Board {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  schoolId    Int?
  school      School?  @relation(fields: [schoolId], references: [id])
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examConfigs    ExamConfig[]
  gradingSchemes GradingScheme[]
  boardVersions  BoardVersion[]

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([isDeleted])
}

model BoardVersion {
  id             Int          @id @default(autoincrement())
  boardId        Int
  board          Board        @relation(fields: [boardId], references: [id])
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  description    String?
  configJson     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([boardId, academicYearId])
  @@index([academicYearId])
}

model ExamConfig {
  id             Int          @id @default(autoincrement())
  boardId        Int
  board          Board        @relation(fields: [boardId], references: [id])
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  name String? // e.g. "Physics Term 1", "English Common"

  weightage          Float
  carryForward       Boolean @default(false)
  maxMarks           Int?
  passMarks          Int?
  theoryMaxMarks     Int?
  practicalMaxMarks  Int?
  internalMaxMarks   Int?
  theoryPassMarks    Int?
  practicalPassMarks Int?
  internalPassMarks  Int?

  gradingSchemeId Int?
  gradingScheme   GradingScheme? @relation(fields: [gradingSchemeId], references: [id])

  // Optional hints (not enforced)
  defaultForSubjectId Int?
  defaultForStreamId  Int?

  isDeleted   Boolean  @default(false)
  createdById Int?
  createdBy   User?    @relation("ConfigCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?    @relation("ConfigUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams     Exam[]   @relation("ExamToConfig") // back-relation
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  @@index([boardId])
  @@index([academicYearId])
  @@index([gradingSchemeId])
  @@index([isDeleted])
}

model GradingScheme {
  id      Int   @id @default(autoincrement())
  boardId Int
  board   Board @relation(fields: [boardId], references: [id])

  grade      String
  minPercent Float
  maxPercent Float
  formula    String?

  isDeleted Boolean  @default(false) // ← Add this
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  // ──── New: creator & updater ─────
  createdById Int?
  createdBy   User? @relation("SchemeCreatedBy", fields: [createdById], references: [id])

  updatedById Int?
  updatedBy   User? @relation("SchemeUpdatedBy", fields: [updatedById], references: [id])

  ExamConfig ExamConfig[]

  @@index([boardId])
  @@index([createdById])
  @@index([updatedById])
  @@index([academicYearId])
}

model ExamTerm {
  id             Int          @id @default(autoincrement())
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  termName       String?

  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?
  createdBy   User?    @relation("TermCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?    @relation("TermUpdatedBy", fields: [updatedById], references: [id])

  exams   Exam[]       @relation("TermToExams")
  results ExamResult[]

  isPublished Boolean   @default(false)
  isLocked    Boolean   @default(false)
  publishedAt DateTime?
  lockedAt    DateTime?

  @@unique([academicYearId, termName])
  @@index([academicYearId])
  @@index([isPublished])
  @@index([isLocked])
  @@index([isDeleted])
}

model Exam {
  id          Int       @id @default(autoincrement())
  termId      Int
  term        ExamTerm  @relation("TermToExams", fields: [termId], references: [id])
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  subjectId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])
  streamId    Int?
  stream      Stream?   @relation(fields: [streamId], references: [id])

  configId Int?
  config   ExamConfig? @relation("ExamToConfig", fields: [configId], references: [id])

  examDate        DateTime
  startTime       DateTime?
  endTime         DateTime?
  venue           String?
  maxMarks        Int?
  passMarks       Int?
  carryForward    Boolean    @default(false)
  isSupplementary Boolean    @default(false)
  attachments     Json?
  status          ExamStatus @default(DRAFT)

  createdById Int?
  createdBy   User? @relation("ExamCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("ExamUpdatedBy", fields: [updatedById], references: [id])

  marks ExamMarks[]

  @@unique([termId, classroomId, subjectId, streamId])
  @@index([termId])
  @@index([classroomId])
  @@index([subjectId])
  @@index([streamId])
  @@index([configId])
  @@index([status])
  @@index([examDate])
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model ExamMarks {
  id Int @id @default(autoincrement())

  theoryMarks    Int?
  practicalMarks Int?
  internalMarks  Int?

  theoryPass    Boolean? @default(false)
  practicalPass Boolean? @default(false)
  internalPass  Boolean? @default(false)

  overallPass Boolean? @default(false)

  examId Int
  exam   Exam @relation(fields: [examId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  marksObtained Int
  remarks       String?

  enteredById Int
  enteredBy   User @relation("MarksEnteredBy", fields: [enteredById], references: [id])

  updatedById Int?
  updatedBy   User? @relation("MarksUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([studentId, examId])
  @@index([enteredById])
  @@index([updatedById])
}

model ExamResult {
  id Int @id @default(autoincrement())

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  termId Int
  term   ExamTerm @relation(fields: [termId], references: [id])

  totalMarks Int
  percentage Float
  grade      String?
  remarks    String?

  // ─── NEW: Better tracking & remarks ───
  calculationRemarks String?
  isComplete         Boolean? @default(false)
  calculationVersion Int      @default(1)

  // ──── Changed: updater is User ─────
  calculatedById Int?
  calculatedBy   User? @relation("ResultCalculatedBy", fields: [calculatedById], references: [id])

  updatedById Int?
  updatedBy   User? @relation("ResultUpdatedBy", fields: [updatedById], references: [id])

  calculatedAt DateTime @default(now())

  @@unique([studentId, termId])
  @@index([studentId, termId])
  @@index([updatedById])
  @@index([isComplete])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  label     String   @unique // "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableSlots    TimetableSlot[]
  examinations      Examination[]
  assignments       Assignment[]
  studentStreams    StudentStream[]
  Attendance        Attendance[]
  ExaminationResult ExaminationResult[]
  Announcement      Announcement[]
  PTMRequest        PTMRequest[]

  teacherAssignments TeacherAssignment[]

  curriculumSubjects CurriculumSubject[]

  feeStructures          FeeStructure[]
  studentFees            StudentFee[]
  lateFeeConfigs         LateFeeConfig[]
  studentTransports      StudentTransport[]
  studentElectiveChoices StudentElectiveChoice[]
  admissionRequests      AdmissionRequest[]

  @@index([isActive])
  @@index([startDate, endDate])
}

model Stream {
  id          Int     @id @default(autoincrement())
  name        String  @unique // "Science", "Commerce"
  description String?

  studentStreams StudentStream[]
  announcements  Announcement[]  @relation("StreamAnnouncements")
  assignments    Assignment[]    @relation("StreamAssignments")

  teacherAssignments TeacherAssignment[]

  curriculumSubjects CurriculumSubject[]

  feeStructures FeeStructure[]
  TimetableSlot TimetableSlot[]

  @@index([name])
}

model StudentStream {
  id Int @id @default(autoincrement())

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id])

  rollNo String?

  createdAt DateTime @default(now())

  @@unique([academicYearId, studentId])
  @@unique([academicYearId, classroomId, rollNo])
  @@index([studentId, academicYearId])
  @@index([classroomId])
}

model School {
  id           Int      @id @default(autoincrement())
  name         String
  schoolCode   String   @unique @db.Char(5)
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rollNoFormat String?

  users              User[]
  students           Student[]
  staff              Staff[]
  classrooms         Classroom[]
  subjects           Subject[]
  examinations       Examination[]
  assignments        Assignment[]
  timetableSlots     TimetableSlot[]
  announcements      Announcement[]      @relation("SchoolAnnouncements")
  curriculumSubjects CurriculumSubject[]
  admissionRequests  AdmissionRequest[]
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model TeacherAssignment {
  id        Int   @id @default(autoincrement())
  teacherId Int
  teacher   Staff @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  classroomId Int?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  fromDate DateTime? // For temporary assignments
  toDate   DateTime? // Null = permanent

  status AssignmentStatus @default(ACTIVE)

  assignedById Int
  assignedBy   User @relation(fields: [assignedById], references: [id])

  assignedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Retain only the full unique index to allow date-based variations
  @@unique([teacherId, subjectId, classroomId, academicYearId, streamId, fromDate, toDate], map: "teacher_assignment_full_idx")
  @@index([teacherId])
  @@index([subjectId])
  @@index([classroomId])
  @@index([academicYearId])
  @@index([streamId])
}

model Student {
  id          Int       @id @default(autoincrement())
  title       String?
  name        String
  email       String    @unique
  grade       String?
  dateOfBirth DateTime?
  enrolledAt  DateTime  @default(now())

  gender               String?
  previousSchoolName   String?
  previousClass        String?
  previousGrade        String?
  promotedToClass      String?
  totalAdmissionAmount Float?
  monthlyFees          Float?
  admissionDate        DateTime?
  admissionReceiptNo   String?
  admissionReceiptLink String?
  city                 String?
  state                String?
  pincode              String?
  address              String?
  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  // a student belongs to a single classroom
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId Int?

  // subjects the student is enrolled in (many-to-many)
  subjects Subject[]

  // attendance records for the student
  attendances Attendance[]

  // examination results for the student
  examinationResults ExaminationResult[]
  ptmRequests        PTMRequest[]

  studentStreams StudentStream[]

  studentFees       StudentFee[]
  studentTransports StudentTransport[]

  parents StudentParent[]

  studentElectiveChoices StudentElectiveChoice[]
  admissionRequest       AdmissionRequest?
}

model Staff {
  id      Int      @id @default(autoincrement())
  hiredAt DateTime @default(now())

  // --- Basic details tab ---
  employeeId        String?   @unique
  title             String?
  name              String
  gender            String?
  employeeType      String?
  role              String
  designation       String?
  dateOfBirth       DateTime?
  dateOfJoining     DateTime?
  fatherHusbandName String?
  qualification     String?

  // --- Address / location block ---
  address  String?
  city     String?
  state    String?
  pincode  String?
  location String?

  // --- Identity details ---
  aadharNumber String?
  panNumber    String?

  // --- Contact block ---
  mobile          String?
  alternateMobile String?
  email           String  @unique
  alternateEmail  String?
  brokerBranch    String?

  // --- Bank details tab ---
  bankName          String?
  bankBranchName    String?
  bankAccountNumber String?
  ifscCode          String?

  // --- Document uploads tab ---
  jobOfferLetterUrl        String?
  joiningLetterUrl         String?
  ndaUrl                   String?
  experienceLetterUrl      String?
  relievingLetterUrl       String?
  salarySlipUrl            String?
  aadhaarCardUrl           String?
  panCardUrl               String?
  cancelledChequeUrl       String?
  passportUrl              String?
  sscCertificateUrl        String?
  hscCertificateUrl        String?
  graduationCertificateUrl String?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  // attendance records for staff
  attendances Attendance[]

  // subjects taught by staff
  subjects Subject[]

  // assignments created by staff
  assignments    Assignment[]
  timetableSlots TimetableSlot[]

  teacherAssignments TeacherAssignment[]
  examinationPermissions ExaminationPermission[]
}

enum Role {
  STUDENT
  STAFF
  ADMIN
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String // hashed password (never store plain text)
  role                Role      @default(STUDENT)
  createdAt           DateTime  @default(now())
  resetToken          String? // for password reset
  resetTokenExpiresAt DateTime?

  student Student?
  staff   Staff?

  // optional relation to a School (useful for ADMIN or general user association)
  school                School?        @relation(fields: [schoolId], references: [id])
  schoolId              Int?
  announcements         Announcement[] @relation("UserAnnouncements")
  ptmRequestsCreated    PTMRequest[]   @relation("PTMRequestedBy")
  ptmRequestsReceived   PTMRequest[]   @relation("PTMRequestedTo")
  ptmRequestsHandled    PTMRequest[]   @relation("PTMRespondedBy")
  leaveRequests         LeaveRequest[] @relation("LeaveRequestedBy")
  leaveRequestsApproved LeaveRequest[] @relation("LeaveApprovedBy")

  discountsCreated   Discount[]      @relation
  adjustmentsCreated FeeAdjustment[] @relation

  teacherAssignmentsAssigned TeacherAssignment[]     @relation
  approvedElectiveChoices    StudentElectiveChoice[] @relation("ElectiveApprovedBy")
  parent                     Parent?
  createdAdmissions          AdmissionRequest[]      @relation("CreatedAdmissions")
  approvedAdmissions         AdmissionRequest[]      @relation("ApprovedAdmissions")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())

  // Either studentId or staffId will be set
  student   Student? @relation(fields: [studentId], references: [id])
  studentId Int?

  staff   Staff? @relation(fields: [staffId], references: [id])
  staffId Int?

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  // Subject (optional - for subject-wise attendance)
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId Int?

  @@unique([studentId, date, academicYearId, subjectId])
  @@unique([staffId, date, academicYearId])
  @@index([studentId])
  @@index([staffId])
  @@index([date])
  @@index([academicYearId])
  @@index([subjectId])
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // teacher responsible for this subject

  teachers Staff[]

  // students enrolled in this subject
  students Student[]

  // optional relation to School
  school   School? @relation(fields: [schoolId], references: [id])
  schoolId Int?

  timetableSlots TimetableSlot[]

  teacherAssignments TeacherAssignment[]

  curriculumSubjects CurriculumSubject[]

  attendances Attendance[]
}

model Classroom {
  id                      Int      @id @default(autoincrement())
  name                    String
  section                 String   @default("A")
  isSubjectWiseAttendance Boolean  @default(false) // Dynamic: determines if this class needs subject-wise attendance
  createdAt               DateTime @default(now())

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  // many-to-many with Student
  students Student[]

  // examinations for this classroom
  examinations Examination[]

  // assignments for this classroom
  assignments    Assignment[]
  timetableSlots TimetableSlot[]
  StudentStream  StudentStream[]

  teacherAssignments TeacherAssignment[]
  announcements      Announcement[]      @relation("ClassroomAnnouncements")
}

enum ExaminationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MarkingSystem {
  MARKS
  GRADE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotType {
  CLASS
  BREAK
}

model Examination {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  subject     String
  examDate    DateTime
  duration    Int // duration in minutes
  totalMarks  Float
  status      ExaminationStatus @default(SCHEDULED)
  markingSystem MarkingSystem   @default(MARKS)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int

  results ExaminationResult[]
  permissions ExaminationPermission[]

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([academicYearId])
  @@index([schoolId])
  @@index([classroomId])
  @@index([examDate])
}

model ExaminationPermission {
  id            Int      @id @default(autoincrement())
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId Int
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId       Int
  canAddMarks   Boolean  @default(true)
  assignedAt    DateTime @default(now())

  @@unique([examinationId, staffId])
  @@index([examinationId])
  @@index([staffId])
}

model ExaminationResult {
  id            Int      @id @default(autoincrement())
  marksObtained Float?
  grade         String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId Int

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([examinationId, studentId])
  @@index([studentId, academicYearId])
  @@index([studentId])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  className   String // e.g. "LKG", "UKG", "Class 1"
  fromDate    DateTime
  toDate      DateTime
  fileUrl     String // link to image or PDF
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  targetClass   String? // e.g. "11"
  targetSection String? // e.g. "A"
  streamId      Int? // e.g. Science
  stream        Stream? @relation("StreamAssignments", fields: [streamId], references: [id])

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int

  createdBy   Staff? @relation(fields: [createdById], references: [id])
  createdById Int?

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([classroomId, academicYearId])
  @@index([schoolId])
  @@index([classroomId])
  @@index([createdById])
  @@index([fromDate])
  @@index([toDate])
}

model TimetableSlot {
  id           Int       @id @default(autoincrement())
  day          DayOfWeek
  slotType     SlotType
  startMinutes Int
  endMinutes   Int
  notes        String?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int

  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId Int?

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  teacher   Staff? @relation(fields: [teacherId], references: [id])
  teacherId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([schoolId])
  @@index([classroomId])
  @@index([day])
  @@index([academicYearId])
  @@index([streamId])
}

enum AnnouncementType {
  notice
  event
}

enum CreatedRole {
  STAFF
  ADMIN
  PRINCIPAL
}

model Announcement {
  id   Int              @id @default(autoincrement())
  type AnnouncementType

  title       String
  description String

  link  String?
  media String?

  classroomId Int?
  classroom   Classroom? @relation("ClassroomAnnouncements", fields: [classroomId], references: [id])

  isSuspended Boolean @default(false)

  createdById   Int
  createdByRole CreatedRole

  createdBy User @relation("UserAnnouncements", fields: [createdById], references: [id])

  schoolId Int
  school   School @relation("SchoolAnnouncements", fields: [schoolId], references: [id])

  streamId Int?
  stream   Stream? @relation("StreamAnnouncements", fields: [streamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([schoolId, isSuspended])
  @@index([classroomId])
}

// PTM Schemas
enum PTMStatus {
  pending
  approved
  postponed
  rejected
}

enum PTMMode {
  online
  offline
}

enum PTMRole {
  STUDENT
  STAFF
  ADMIN
  PARENT
}

model PTMRequest {
  id Int @id @default(autoincrement())

  // Student involved
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  class   String
  section String

  // Request creator
  requestedById   Int
  requestedBy     User    @relation("PTMRequestedBy", fields: [requestedById], references: [id])
  requestedByRole PTMRole

  // Receiver
  requestedToId   Int
  requestedTo     User    @relation("PTMRequestedTo", fields: [requestedToId], references: [id])
  requestedToRole PTMRole

  requestedDate DateTime
  requestedTime String
  mode          PTMMode  @default(offline)

  status PTMStatus @default(pending)

  responseById   Int?
  responseBy     User?     @relation("PTMRespondedBy", fields: [responseById], references: [id])
  responseByRole PTMRole?
  responseDate   DateTime?

  suggestedDate DateTime?
  suggestedTime String?

  purpose String?

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId])
  @@index([studentId])
  @@index([requestedById])
  @@index([requestedToId])
  @@index([status])
}

enum LeaveType {
  casual
  sick
  earned
  other
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum LeaveUserRole {
  staff
  admin
}

model LeaveRequest {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("LeaveRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  userRole       LeaveUserRole
  leaveType      LeaveType
  reason         String        @db.Text
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  numberOfDays   Int
  status         LeaveStatus   @default(pending)
  approvedBy     Int?
  approvedByUser User?         @relation("LeaveApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([approvedBy])
}

enum CurriculumCategory {
  CORE
  ELECTIVE
  ACTIVITY
}

model CurriculumSubject {
  id Int @id @default(autoincrement())

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  className String // e.g., "Class 11"

  streamId Int?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  category    CurriculumCategory
  isMandatory Boolean            @default(true)

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentElectiveChoices StudentElectiveChoice[]

  @@unique([academicYearId, className, streamId, subjectId])
  @@index([academicYearId])
  @@index([className])
  @@index([streamId])
  @@index([subjectId])
}

enum FeeCategoryType {
  TUITION
  TRANSPORT
  EXAM
  ADMISSION
  REGISTRATION
  CAUTION_MONEY
  ID_CARD
  ANNUAL_CHARGES
  LIBRARY
  COMPUTER
  LABORATORY
  SPORTS
  ARTS
  HOSTEL
  MESS
  BOOKS
  UNIFORM
  INSURANCE
  LAB
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum AdjustmentType {
  REFUND
  FINE
  DISCOUNT
  OTHER
}

model FeeCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  type        FeeCategoryType
  description String?
  isDefault   Boolean         @default(false) // Built-in like Tuition
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  feeStructures FeeStructure[]
}

model FeeStructure {
  id             Int      @id @default(autoincrement())
  academicYearId Int
  className      String // e.g., "Class 11"
  streamId       Int?
  categoryId     Int
  amount         Float
  isLocked       Boolean  @default(false) // For previous years
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  stream       Stream?      @relation(fields: [streamId], references: [id], onDelete: SetNull)
  category     FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  studentFeeItems StudentFeeItem[]

  @@unique([academicYearId, className, streamId, categoryId])
  @@index([academicYearId])
  @@index([className])
  @@index([streamId])
  @@index([categoryId])
}

model StudentFee {
  id             Int @id @default(autoincrement())
  studentId      Int
  academicYearId Int

  totalAmount     Float
  paidAmount      Float     @default(0)
  dueAmount       Float
  lastPaymentDate DateTime?
  isFrozen        Boolean   @default(false) // Freeze after admission
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  payments    Payment[]
  discounts   Discount[]
  adjustments FeeAdjustment[]
  lateFees    LateFee[]
  items       StudentFeeItem[]

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
}

model StudentFeeItem {
  id             Int      @id @default(autoincrement())
  studentFeeId   Int
  feeStructureId Int
  assignedAmount Float // Copy of amount at time of assignment (for history)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studentFee   StudentFee   @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@unique([studentFeeId, feeStructureId])
  @@index([studentFeeId])
  @@index([feeStructureId])
}

model Payment {
  id           Int           @id @default(autoincrement())
  studentFeeId Int
  amount       Float
  paymentDate  DateTime      @default(now())
  method       PaymentMethod
  receiptNo    String?       @unique
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
  @@index([paymentDate])
}

model Discount {
  id           Int          @id @default(autoincrement())
  studentFeeId Int
  type         DiscountType
  amount       Float? // For FIXED
  percentage   Float? // For PERCENTAGE
  reason       String
  appliedDate  DateTime     @default(now())
  createdById  Int // Admin/Staff who applied
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@index([studentFeeId])
}

model LateFeeConfig {
  id             Int      @id @default(autoincrement())
  academicYearId Int
  fineAmount     Float
  isPercentage   Boolean  @default(false) // % of due or fixed
  perPeriod      String // e.g., "MONTHLY"
  graceDays      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId])
}

model LateFee {
  id           Int      @id @default(autoincrement())
  studentFeeId Int
  amount       Float
  appliedDate  DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
}

model TransportRoute {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  feeAmount   Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentTransports StudentTransport[]
}

model StudentTransport {
  id             Int       @id @default(autoincrement())
  studentId      Int
  academicYearId Int
  routeId        Int
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([routeId])
}

model FeeAdjustment {
  id             Int            @id @default(autoincrement())
  studentFeeId   Int
  type           AdjustmentType
  amount         Float // Negative for refund
  reason         String
  adjustmentDate DateTime       @default(now())
  createdById    Int
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@index([studentFeeId])
}

enum ParentType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Parent {
  id        Int        @id @default(autoincrement())
  type      ParentType
  name      String // Required in controller
  email     String     @unique
  phone     String?
  address   String?
  isActive  Boolean    @default(true) // For soft delete
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  students StudentParent[] // Many-to-many
}

model StudentParent {
  studentId Int
  parentId  Int
  isPrimary Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
}

enum ElectiveStatus {
  PENDING
  APPROVED
  REJECTED
  DROPPED
}

model StudentElectiveChoice {
  id Int @id @default(autoincrement())

  studentId           Int
  academicYearId      Int
  curriculumSubjectId Int

  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)

  approvedById Int?
  approvedBy   User?     @relation("ElectiveApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @default(now())

  status ElectiveStatus @default(PENDING)

  @@unique([studentId, academicYearId, curriculumSubjectId])
  @@index([studentId, academicYearId])
  @@index([curriculumSubjectId])
}

model AdmissionRequest {
  id                   Int             @id @default(autoincrement())
  name                 String
  email                String          @unique //student_email
  gender               Gender?
  dateOfBirth          DateTime?
  previousSchoolName   String?
  previousClass        String?
  previousGrade        String?
  promotedToClass      String?
  totalAdmissionAmount Float?
  monthlyFees          Float?
  admissionDate        DateTime?
  admissionReceiptNo   String?
  admissionReceiptLink String? // URL to receipt/document
  parents              Json? // [{type, name, email, phone, ...}]
  electiveSubjects     Json? // [subjectId, ...]
  requestedClassroomId Int?
  requestedStreamId    Int?
  status               AdmissionStatus @default(PENDING)
  notes                String? // Admin internal notes
  schoolId             Int
  academicYearId       Int?
  createdById          Int? // if submitted by logged-in user
  approvedById         Int? // admin who approved
  studentId            Int?            @unique
  student              Student?        @relation(fields: [studentId], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  school       School        @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  createdBy    User?         @relation("CreatedAdmissions", fields: [createdById], references: [id])
  approvedBy   User?         @relation("ApprovedAdmissions", fields: [approvedById], references: [id])

  @@index([schoolId, status])
  @@index([academicYearId])
  @@index([status])
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
